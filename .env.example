# 이 파일을 레포 루트에 `.env` 로 복사해서 사용합니다. (백엔드가 ../.env 를 읽음)
# 소셜 로그인 키는 선택 사항 — 주석 처리된 상태(값 없음)면 해당 버튼이 화면에서 숨겨지고,
# 백엔드는 이메일 로그인만으로 정상 기동합니다. 쓰려면 주석을 풀고 실제 키를 넣으세요.

# ── 서버 포트 ────────────────────────────────────────
PORT=4003

# ── 프론트엔드(Vite) ─────────────────────────────────
VITE_API_URL=http://localhost:4003/api

# ── DB ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=easit
DB_PASS=easit1234
DB_NAME=easit

# ── JWT ─────────────────────────────────────────────
# 미설정 시 개발용 기본 시크릿으로 동작합니다(운영에서는 반드시 설정).
JWT_SECRET=여기에_32자_이상_랜덤_문자열_입력

# ── 카카오 (선택) ─────────────────────────────────────
# developers.kakao.com → 내 애플리케이션 → 앱 키
# KAKAO_REST_API_KEY=여기에_카카오_REST_API_키
KAKAO_CALLBACK_URL=http://localhost:4003/api/auth/kakao/callback

# ── 네이버 (선택) ─────────────────────────────────────
# developers.naver.com → Application → 네이버 로그인
# NAVER_CLIENT_ID=여기에_네이버_클라이언트_ID
# NAVER_CLIENT_SECRET=여기에_네이버_클라이언트_시크릿
NAVER_CALLBACK_URL=http://localhost:4003/api/auth/naver/callback

# ── 구글 (선택) ───────────────────────────────────────
# console.cloud.google.com → API 및 서비스 → 사용자 인증정보
# GOOGLE_CLIENT_ID=여기에_구글_클라이언트_ID
# GOOGLE_CLIENT_SECRET=여기에_구글_클라이언트_시크릿
GOOGLE_CALLBACK_URL=http://localhost:4003/api/auth/google/callback

# ── 지하철 실시간 API (선택, 프론트 미사용) ──────────────
# data.seoul.go.kr → 인증키 발급
SEOUL_API_KEY=여기에_서울_열린데이터_API_키
# tago.go.kr → 회원가입 후 인증키 발급
TAGO_API_KEY=여기에_TAGO_API_키

# ── 프론트엔드 URL ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173
